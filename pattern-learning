/*
==================================================
       C PROGRAMMING - PATTERN COLLECTION
                  PATTERNS 1 TO 13
==================================================
*/

#include <stdio.h>

int main()
{
    int n, row, col;
    scanf("%d", &n);

    // 1. SQUARE STAR PATTERN
    printf("\n1. SQUARE STAR PATTERN\n");

    for(row=0; row<n; row++)
    {
        for(col=0; col<n; col++)
            printf("* ");
        printf("\n");
    }

    // 2. RIGHT-ANGLED TRIANGLE
    printf("\n2. RIGHT-ANGLED TRIANGLE\n");

    for(row=0; row<n; row++)
    {
        for(col=0; col<=row; col++)
            printf("* ");
        printf("\n");
    }

    // 3. INVERTED TRIANGLE
    printf("\n3. INVERTED TRIANGLE\n");

    for(row=0; row<n; row++)
    {
        for(col=0; col<n-row; col++)
            printf("* ");
        printf("\n");
    }

    // 4. INCREASING STAR PATTERN
    printf("\n4. INCREASING STAR PATTERN\n");

    for(row=0; row<n; row++)
    {
        for(col=0; col<=2*row-1; col++)
            printf("* ");
        printf("\n");
    }

    // 5. RIGHT-SHIFTED SQUARE PATTERN
    printf("\n5. RIGHT-SHIFTED SQUARE PATTERN\n");

    for(row=0; row<n; row++)
    {
        for(col=0; col<=row-1; col++)
            printf(" ");

        for(col=0; col<=n; col++)
            printf("*");

        printf("\n");
    }

    // 6. SQUARE PATTERN WITH DECREASING SPACES
    printf("\n6. SQUARE PATTERN WITH DECREASING SPACES\n");

    for(row=0; row<n; row++)
    {
        for(col=0; col<n-row-2; col++)
            printf(" ");

        for(col=0; col<=n; col++)
            printf("*");

        printf("\n");
    }

    // 7. RIGHT-ALIGNED INCREASING TRIANGLE
    printf("\n7. RIGHT-ALIGNED INCREASING TRIANGLE\n");

    for(row=0; row<n; row++)
    {
        for(col=0; col<n-row-1; col++)
            printf(" ");

        for(col=0; col<=row; col++)
            printf("*");

        printf("\n");
    }

    // 8. DOUBLE-SIDED INCREASING STAR PATTERN
    printf("\n8. DOUBLE-SIDED INCREASING STAR PATTERN\n");

    for(row=0; row<n; row++)
    {
        for(col=0; col<=row; col++)
            printf("*");

        for(col=0; col<n-row-1; col++)
            printf(" ");

        for(col=0; col<=row; col++)
            printf("*");

        printf("\n");
    }

    // 9. SQUARE NUMBER PATTERN
    printf("\n9. SQUARE NUMBER PATTERN\n");

    for(row=0; row<n; row++)
    {
        for(col=0; col<n; col++)
            printf("1");

        printf("\n");
    }

    // 10. ROW NUMBER PATTERN
    printf("\n10. ROW NUMBER PATTERN\n");

    for(row=0; row<n; row++)
    {
        for(col=0; col<n; col++)
            printf("%d", row+1);

        printf("\n");
    }

    // 11. COLUMN NUMBER PATTERN
    printf("\n11. COLUMN NUMBER PATTERN\n");

    for(row=0; row<n; row++)
    {
        for(col=0; col<n; col++)
            printf("%d", col+1);

        printf("\n");
    }

    // 12. INCREASING NUMBER TRIANGLE
    printf("\n12. INCREASING NUMBER TRIANGLE\n");

    for(row=0; row<n; row++)
    {
        for(col=0; col<=row; col++)
            printf("%d", col+1);

        printf("\n");
    }

    // 13. DECREASING NUMBER TRIANGLE
    printf("\n13. DECREASING NUMBER TRIANGLE\n");

    for(row=0; row<=n; row++)
    {
        for(col=0; col<=n-row; col++)
            printf("%d", col+1);

        printf("\n");
    }

    return 0;
}

